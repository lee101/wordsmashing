{% set site_url = "https://" ~ request.url.netloc %}<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
	<url>
		<loc>{{ site_url }}</loc>
		<changefreq>weekly</changefreq>
		<priority>1</priority>
	</url>
	<url>
		<loc>{{ site_url }}/versus</loc>
		<changefreq>weekly</changefreq>
		<priority>1</priority>
	</url>
	<url>
		<loc>{{ site_url }}/versus/1player</loc>
		<changefreq>weekly</changefreq>
		<priority>1</priority>
	</url>
	<url>
		<loc>{{ site_url }}/versus/2player</loc>
		<changefreq>weekly</changefreq>
		<priority>1</priority>
	</url>
	<url>
		<loc>{{ site_url }}/campaign</loc>
		<changefreq>weekly</changefreq>
		<priority>1</priority>
	</url>
	<url>
		<loc>{{ site_url }}/learn-english</loc>
		<changefreq>weekly</changefreq>
		<priority>1</priority>
	</url>
	{% for key, level in learnenglishlevels.items() %}
